rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 1: Global deny-all catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isStr(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isOptStr(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isOptNumberInRange(data, field, minVal, maxVal) {
      return !(field in data) || (data[field] is number && data[field] >= minVal && data[field] <= maxVal);
    }

    function isOptTimestamp(data, field) {
      return !(field in data) || isValidTimestamp(data[field]);
    }

    function isValidCategory(cat) {
      return cat in ['laundry', 'tailoring', 'footwear'];
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---
    function isValidUserProfile(data) {
      return isStr(data.userId, 1, 128) &&
             isStr(data.displayName, 1, 60) &&
             data.activeRole in ['customer', 'worker', 'partner'] &&
             isStr(data.activeLocality, 1, 80) &&
             isOptStr(data, 'phoneMasked', 24) &&
             isOptStr(data, 'photoUrl', 200000) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSavedAddress(data) {
      return isStr(data.userId, 1, 128) &&
             isStr(data.label, 1, 30) &&
             isStr(data.houseNo, 1, 60) &&
             isStr(data.street, 1, 100) &&
             isOptStr(data, 'landmark', 80) &&
             isStr(data.locality, 1, 60) &&
             isStr(data.city, 1, 50) &&
             isStr(data.postalCode, 3, 12) &&
             isOptStr(data, 'instructions', 160) &&
             data.defaultAddress is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidNotification(data) {
      return isStr(data.userId, 1, 128) &&
             isStr(data.title, 1, 80) &&
             isStr(data.message, 1, 240) &&
             data.category in ['booking', 'pickup', 'quote', 'payment', 'support'] &&
             isOptStr(data, 'bookingId', 128) &&
             data.readFlag is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidShop(data) {
      return isStr(data.ownerId, 1, 128) &&
             isStr(data.shopName, 2, 80) &&
             isValidCategory(data.category) &&
             isStr(data.tagline, 0, 140) &&
             isStr(data.locality, 1, 80) &&
             isStr(data.addressSummary, 1, 160) &&
             isStr(data.hoursSummary, 1, 80) &&
             isStr(data.turnaroundLabel, 1, 40) &&
             data.openStatus is bool &&
             data.published is bool &&
             data.verified is bool &&
             data.supportsShopDrop is bool &&
             data.supportsWorkerDelivery is bool &&
             data.supportsClickitBatch is bool &&
             data.dailyCapacity is int && data.dailyCapacity >= 1 && data.dailyCapacity <= 500 &&
             data.activeLoad is int && data.activeLoad >= 0 && data.activeLoad <= 500 &&
             data.ratingAvg is number && data.ratingAvg >= 0 && data.ratingAvg <= 5 &&
             data.ratingCount is int && data.ratingCount >= 0 &&
             data.startingPriceMinor is int && data.startingPriceMinor >= 0 && data.startingPriceMinor <= 10000000 &&
             isStr(data.startingPriceUnit, 1, 24) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidShopService(data) {
      return isStr(data.shopId, 1, 128) &&
             isStr(data.ownerId, 1, 128) &&
             isStr(data.name, 2, 80) &&
             isStr(data.description, 0, 200) &&
             isOptStr(data, 'inclusions', 160) &&
             isValidCategory(data.category) &&
             isStr(data.unit, 1, 24) &&
             data.priceMinor is int && data.priceMinor >= 100 && data.priceMinor <= 10000000 &&
             data.minQty is int && data.minQty >= 1 && data.minQty <= 100 &&
             data.turnaroundHours is int && data.turnaroundHours >= 1 && data.turnaroundHours <= 720 &&
             data.active is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidBooking(data) {
      return isStr(data.customerId, 1, 128) &&
             isStr(data.customerName, 1, 60) &&
             isStr(data.workerOwnerId, 1, 128) &&
             isStr(data.shopId, 1, 128) &&
             isStr(data.shopName, 1, 80) &&
             isValidCategory(data.category) &&
             isOptStr(data, 'assignedPartnerId', 128) &&
             data.status in [
               'requested', 'accepted', 'quote_pending', 'confirmed',
               'pickup_scheduled', 'picked_up', 'received_by_worker',
               'in_progress', 'ready', 'return_scheduled',
               'out_for_delivery', 'delivered', 'completed',
               'cancelled', 'disputed'
             ] &&
             data.quoteStatus in ['estimated', 'awaiting_worker_confirmation', 'quote_revision_sent', 'confirmed'] &&
             isOptStr(data, 'quoteNote', 200) &&
             data.fulfilmentMethod in ['shop_drop', 'worker_delivery', 'clickit_pickup_return'] &&
             isStr(data.slotWindowLabel, 1, 60) &&
             data.batchEligible is bool &&
             data.batchOptIn is bool &&
             isStr(data.addressLabel, 1, 40) &&
             isStr(data.addressSummary, 1, 200) &&
             isStr(data.parcelCode, 4, 24) &&
             data.handoverOtp is string && data.handoverOtp.matches('^[0-9]{4,8}$') &&
             data.deliveryOtp is string && data.deliveryOtp.matches('^[0-9]{4,8}$') &&
             isStr(data.itemsSummary, 1, 240) &&
             data.itemCount is int && data.itemCount >= 1 && data.itemCount <= 500 &&
             data.weightKg is number && data.weightKg >= 0 && data.weightKg <= 500 &&
             data.serviceSubtotalMinor is int && data.serviceSubtotalMinor >= 0 && data.serviceSubtotalMinor <= 100000000 &&
             data.deliveryFeeMinor is int && data.deliveryFeeMinor >= 0 && data.deliveryFeeMinor <= 1000000 &&
             data.platformFeeMinor is int && data.platformFeeMinor >= 0 && data.platformFeeMinor <= 1000000 &&
             data.totalMinor is int && data.totalMinor >= 0 && data.totalMinor <= 100000000 &&
             data.paymentStatus in ['pending', 'paid', 'refunded'] &&
             isOptStr(data, 'paymentMethod', 32) &&
             isOptStr(data, 'paymentRef', 64) &&
             isStr(data.milestone, 0, 60) &&
             data.ratingStars is int && data.ratingStars >= 0 && data.ratingStars <= 5 &&
             isOptStr(data, 'reviewText', 300) &&
             isOptStr(data, 'cancellationReason', 160) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidBookingMutation(data) {
      return isOptStr(data, 'assignedPartnerId', 128) &&
             data.status in [
               'requested', 'accepted', 'quote_pending', 'confirmed',
               'pickup_scheduled', 'picked_up', 'received_by_worker',
               'in_progress', 'ready', 'return_scheduled',
               'out_for_delivery', 'delivered', 'completed',
               'cancelled', 'disputed'
             ] &&
             data.quoteStatus in ['estimated', 'awaiting_worker_confirmation', 'quote_revision_sent', 'confirmed'] &&
             isOptStr(data, 'quoteNote', 200) &&
             data.serviceSubtotalMinor is int && data.serviceSubtotalMinor >= 0 && data.serviceSubtotalMinor <= 100000000 &&
             data.deliveryFeeMinor is int && data.deliveryFeeMinor >= 0 && data.deliveryFeeMinor <= 1000000 &&
             data.platformFeeMinor is int && data.platformFeeMinor >= 0 && data.platformFeeMinor <= 1000000 &&
             data.totalMinor is int && data.totalMinor >= 0 && data.totalMinor <= 100000000 &&
             data.paymentStatus in ['pending', 'paid', 'refunded'] &&
             isOptStr(data, 'paymentMethod', 32) &&
             isOptStr(data, 'paymentRef', 64) &&
             isStr(data.milestone, 0, 60) &&
             data.ratingStars is int && data.ratingStars >= 0 && data.ratingStars <= 5 &&
             isOptStr(data, 'reviewText', 300) &&
             isOptStr(data, 'cancellationReason', 160) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidTimelineEvent(data) {
      return isStr(data.customerId, 1, 128) &&
             isStr(data.workerOwnerId, 1, 128) &&
             isStr(data.actorId, 1, 128) &&
             data.actorRole in ['customer', 'worker', 'partner', 'system'] &&
             isStr(data.status, 1, 40) &&
             isStr(data.title, 1, 80) &&
             isStr(data.detail, 1, 200) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidDeliveryTask(data) {
      return isStr(data.bookingId, 1, 128) &&
             isStr(data.customerId, 1, 128) &&
             isStr(data.workerOwnerId, 1, 128) &&
             isOptStr(data, 'partnerId', 128) &&
             isStr(data.batchId, 1, 64) &&
             data.taskType in ['pickup', 'return'] &&
             data.status in ['offered', 'accepted', 'arrived', 'picked_up', 'handed_over', 'delivered', 'exception'] &&
             isStr(data.pickupZone, 1, 80) &&
             isStr(data.dropZone, 1, 80) &&
             isStr(data.shopName, 1, 80) &&
             isStr(data.timeWindowLabel, 1, 60) &&
             isStr(data.parcelCode, 4, 24) &&
             data.itemCount is int && data.itemCount >= 1 && data.itemCount <= 500 &&
             data.estimatedWeightKg is number && data.estimatedWeightKg >= 0 && data.estimatedWeightKg <= 500 &&
             data.payoutMinor is int && data.payoutMinor >= 0 && data.payoutMinor <= 1000000 &&
             data.batchStopIndex is int && data.batchStopIndex >= 1 && data.batchStopIndex <= 20 &&
             data.batchTotalStops is int && data.batchTotalStops >= 1 && data.batchTotalStops <= 20 &&
             isOptStr(data, 'exceptionReason', 160) &&
             isOptNumberInRange(data, 'pickupLat', -90, 90) &&
             isOptNumberInRange(data, 'pickupLng', -180, 180) &&
             isOptNumberInRange(data, 'dropLat', -90, 90) &&
             isOptNumberInRange(data, 'dropLng', -180, 180) &&
             isOptNumberInRange(data, 'agentLat', -90, 90) &&
             isOptNumberInRange(data, 'agentLng', -180, 180) &&
             isOptNumberInRange(data, 'agentBearing', 0, 360) &&
             isOptTimestamp(data, 'locationUpdatedAt') &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSupportTicket(data) {
      return isStr(data.userId, 1, 128) &&
             isOptStr(data, 'bookingId', 128) &&
             isStr(data.category, 1, 40) &&
             isStr(data.subject, 3, 100) &&
             isStr(data.description, 5, 400) &&
             data.status in ['open', 'in_review', 'resolved'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // --- COLLECTIONS ---

    match /users/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'activeRole', 'activeLocality', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'activeRole', 'activeLocality', 'phoneMasked', 'photoUrl', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'activeRole', 'activeLocality', 'phoneMasked', 'photoUrl', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /addresses/{addressId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(addressId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'label', 'houseNo', 'street', 'locality', 'city', 'postalCode', 'defaultAddress', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'label', 'houseNo', 'street', 'landmark', 'locality', 'city', 'postalCode', 'instructions', 'defaultAddress', 'createdAt', 'updatedAt']) &&
                         isValidSavedAddress(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(addressId) &&
                         isValidSavedAddress(incoming()) &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['label', 'houseNo', 'street', 'landmark', 'locality', 'city', 'postalCode', 'instructions', 'defaultAddress', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(addressId) && request.auth.uid == userId;
      }

      match /notifications/{notificationId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(notificationId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'title', 'message', 'category', 'readFlag', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'message', 'category', 'bookingId', 'readFlag', 'createdAt', 'updatedAt']) &&
                         isValidNotification(incoming()) && (
                           request.auth.uid == userId || (
                             'bookingId' in incoming() &&
                             isValidId(incoming().bookingId) &&
                             exists(/databases/$(database)/documents/bookings/$(incoming().bookingId)) &&
                             (
                               get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.customerId == request.auth.uid ||
                               get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.workerOwnerId == request.auth.uid
                             ) && (
                               get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.customerId == userId ||
                               get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.workerOwnerId == userId
                             )
                           )
                         );

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(notificationId) &&
                         isValidNotification(incoming()) &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['readFlag', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(notificationId) && request.auth.uid == userId;
      }
    }

    match /shops/{shopId} {
      allow get, list: if isSignedIn() && (resource.data.published == true || resource.data.ownerId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(shopId) &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'ownerId', 'shopName', 'category', 'tagline', 'locality', 'addressSummary',
                         'hoursSummary', 'turnaroundLabel', 'openStatus', 'published', 'verified',
                         'supportsShopDrop', 'supportsWorkerDelivery', 'supportsClickitBatch',
                         'dailyCapacity', 'activeLoad', 'ratingAvg', 'ratingCount',
                         'startingPriceMinor', 'startingPriceUnit', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'ownerId', 'shopName', 'category', 'tagline', 'locality', 'addressSummary',
                         'hoursSummary', 'turnaroundLabel', 'openStatus', 'published', 'verified',
                         'supportsShopDrop', 'supportsWorkerDelivery', 'supportsClickitBatch',
                         'dailyCapacity', 'activeLoad', 'ratingAvg', 'ratingCount',
                         'startingPriceMinor', 'startingPriceUnit', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidShop(incoming());

      allow update: if isSignedIn() &&
                       isValidId(shopId) &&
                       isValidShop(incoming()) &&
                       existing().ownerId == request.auth.uid &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'shopName', 'category', 'tagline', 'locality', 'addressSummary',
                         'hoursSummary', 'turnaroundLabel', 'openStatus', 'published',
                         'supportsShopDrop', 'supportsWorkerDelivery', 'supportsClickitBatch',
                         'dailyCapacity', 'startingPriceMinor', 'startingPriceUnit', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(shopId) && existing().ownerId == request.auth.uid;

      match /services/{serviceId} {
        allow get, list: if isSignedIn() && (resource.data.active == true || resource.data.ownerId == request.auth.uid);

        allow create: if isSignedIn() &&
                         isValidId(shopId) &&
                         isValidId(serviceId) &&
                         incoming().shopId == shopId &&
                         incoming().ownerId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'shopId', 'ownerId', 'name', 'description', 'category', 'unit',
                           'priceMinor', 'minQty', 'turnaroundHours', 'active', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'shopId', 'ownerId', 'name', 'description', 'inclusions', 'category', 'unit',
                           'priceMinor', 'minQty', 'turnaroundHours', 'active', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidShopService(incoming()) &&
                         existsAfter(/databases/$(database)/documents/shops/$(shopId)) &&
                         getAfter(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;

        allow update: if isSignedIn() &&
                         isValidId(shopId) &&
                         isValidId(serviceId) &&
                         isValidShopService(incoming()) &&
                         existing().ownerId == request.auth.uid &&
                         incoming().ownerId == existing().ownerId &&
                         incoming().shopId == existing().shopId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'name', 'description', 'inclusions', 'category', 'unit',
                           'priceMinor', 'minQty', 'turnaroundHours', 'active', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(shopId) && isValidId(serviceId) && existing().ownerId == request.auth.uid;
      }
    }

    match /bookings/{bookingId} {
      allow get, list: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.workerOwnerId == request.auth.uid ||
        ('assignedPartnerId' in resource.data && resource.data.assignedPartnerId == request.auth.uid)
      );

      allow create: if isSignedIn() &&
                       isValidId(bookingId) &&
                       incoming().customerId == request.auth.uid &&
                       incoming().status == 'requested' &&
                       incoming().paymentStatus == 'pending' &&
                       incoming().ratingStars == 0 &&
                       incoming().keys().hasAll([
                         'customerId', 'customerName', 'workerOwnerId', 'shopId', 'shopName',
                         'category', 'status', 'quoteStatus', 'fulfilmentMethod', 'slotWindowLabel',
                         'batchEligible', 'batchOptIn', 'addressLabel', 'addressSummary',
                         'parcelCode', 'handoverOtp', 'deliveryOtp', 'itemsSummary', 'itemCount',
                         'weightKg', 'serviceSubtotalMinor', 'deliveryFeeMinor', 'platformFeeMinor',
                         'totalMinor', 'paymentStatus', 'milestone', 'ratingStars', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'customerId', 'customerName', 'workerOwnerId', 'shopId', 'shopName',
                         'category', 'assignedPartnerId', 'status', 'quoteStatus', 'quoteNote',
                         'fulfilmentMethod', 'slotWindowLabel', 'batchEligible', 'batchOptIn',
                         'addressLabel', 'addressSummary', 'parcelCode', 'handoverOtp', 'deliveryOtp',
                         'itemsSummary', 'itemCount', 'weightKg', 'serviceSubtotalMinor',
                         'deliveryFeeMinor', 'platformFeeMinor', 'totalMinor', 'paymentStatus',
                         'paymentMethod', 'paymentRef',
                         'milestone', 'ratingStars', 'reviewText', 'cancellationReason',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidBooking(incoming()) &&
                       incoming().platformFeeMinor >= 100 &&
                       incoming().totalMinor == incoming().serviceSubtotalMinor + incoming().deliveryFeeMinor + incoming().platformFeeMinor &&
                       exists(/databases/$(database)/documents/shops/$(incoming().shopId)) &&
                       get(/databases/$(database)/documents/shops/$(incoming().shopId)).data.ownerId == incoming().workerOwnerId;

      allow update: if isSignedIn() &&
                       isValidId(bookingId) &&
                       incoming().customerId == existing().customerId &&
                       incoming().workerOwnerId == existing().workerOwnerId &&
                       incoming().shopId == existing().shopId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidBookingMutation(incoming()) && (
                         // 1) Terminal completed: only one-time rating submission by customer
                         (existing().status == 'completed' &&
                          existing().customerId == request.auth.uid &&
                          existing().ratingStars == 0 &&
                          incoming().status == 'completed' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['ratingStars', 'reviewText', 'updatedAt'])) ||
                         // 2) Customer quote approval, payment, receipt completion (paid only), or cancel/refund
                         (existing().customerId == request.auth.uid &&
                          existing().status != 'completed' &&
                          existing().status != 'cancelled' &&
                          incoming().status in [existing().status, 'pickup_scheduled', 'confirmed', 'completed', 'cancelled'] &&
                          (incoming().status != 'completed' || existing().paymentStatus == 'paid') &&
                          (
                            incoming().paymentStatus == existing().paymentStatus ||
                            (existing().paymentStatus == 'pending' &&
                             incoming().paymentStatus == 'paid' &&
                             'paymentMethod' in incoming() && isStr(incoming().paymentMethod, 1, 32) &&
                             'paymentRef' in incoming() && isStr(incoming().paymentRef, 1, 64)) ||
                            (existing().paymentStatus == 'paid' &&
                             incoming().paymentStatus == 'refunded' &&
                             incoming().status == 'cancelled')
                          ) &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'quoteStatus', 'paymentStatus', 'paymentMethod', 'paymentRef',
                            'cancellationReason', 'updatedAt'
                          ])) ||
                         // 3) Worker accept, quote revision, receive, progress, ready, handover
                         (existing().workerOwnerId == request.auth.uid &&
                          existing().status != 'completed' &&
                          existing().status != 'cancelled' &&
                          incoming().status in [
                            existing().status, 'accepted', 'quote_pending', 'confirmed',
                            'pickup_scheduled', 'received_by_worker', 'in_progress',
                            'ready', 'return_scheduled', 'cancelled'
                          ] &&
                          incoming().totalMinor == incoming().serviceSubtotalMinor + incoming().deliveryFeeMinor + incoming().platformFeeMinor &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'quoteStatus', 'quoteNote',
                            'serviceSubtotalMinor', 'deliveryFeeMinor', 'platformFeeMinor', 'totalMinor',
                            'milestone', 'cancellationReason', 'updatedAt'
                          ])) ||
                         // 4) Delivery partner claim or custody/delivery progress
                         (existing().status != 'completed' &&
                          existing().status != 'cancelled' &&
                          (('assignedPartnerId' in existing() && existing().assignedPartnerId == request.auth.uid) ||
                           (existing().status in ['pickup_scheduled', 'return_scheduled'] &&
                            (!('assignedPartnerId' in existing()) || existing().status == 'return_scheduled') &&
                            incoming().assignedPartnerId == request.auth.uid)) &&
                          incoming().status in [existing().status, 'picked_up', 'received_by_worker', 'out_for_delivery', 'delivered'] &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'assignedPartnerId', 'status', 'milestone', 'updatedAt'
                          ]))
                       );

      match /timeline/{eventId} {
        allow get, list: if isSignedIn() && (
          resource.data.customerId == request.auth.uid ||
          resource.data.workerOwnerId == request.auth.uid
        );

        allow create: if isSignedIn() &&
                         isValidId(bookingId) &&
                         isValidId(eventId) &&
                         incoming().actorId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'customerId', 'workerOwnerId', 'actorId', 'actorRole',
                           'status', 'title', 'detail', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'customerId', 'workerOwnerId', 'actorId', 'actorRole',
                           'status', 'title', 'detail', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidTimelineEvent(incoming()) &&
                         exists(/databases/$(database)/documents/bookings/$(bookingId)) &&
                         get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId == incoming().customerId &&
                         get(/databases/$(database)/documents/bookings/$(bookingId)).data.workerOwnerId == incoming().workerOwnerId && (
                           get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId == request.auth.uid ||
                           get(/databases/$(database)/documents/bookings/$(bookingId)).data.workerOwnerId == request.auth.uid ||
                           ('assignedPartnerId' in get(/databases/$(database)/documents/bookings/$(bookingId)).data &&
                            get(/databases/$(database)/documents/bookings/$(bookingId)).data.assignedPartnerId == request.auth.uid)
                         );
      }
    }

    match /delivery_tasks/{taskId} {
      allow get, list: if isSignedIn() && (
        resource.data.status == 'offered' ||
        ('partnerId' in resource.data && resource.data.partnerId == request.auth.uid) ||
        resource.data.customerId == request.auth.uid ||
        resource.data.workerOwnerId == request.auth.uid
      );

      allow create: if isSignedIn() &&
                       isValidId(taskId) &&
                       (incoming().customerId == request.auth.uid || incoming().workerOwnerId == request.auth.uid) &&
                       incoming().status == 'offered' &&
                       incoming().keys().hasAll([
                         'bookingId', 'customerId', 'workerOwnerId', 'batchId', 'taskType',
                         'status', 'pickupZone', 'dropZone', 'shopName', 'timeWindowLabel',
                         'parcelCode', 'itemCount', 'estimatedWeightKg', 'payoutMinor',
                         'batchStopIndex', 'batchTotalStops', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'bookingId', 'customerId', 'workerOwnerId', 'partnerId', 'batchId', 'taskType',
                         'status', 'pickupZone', 'dropZone', 'shopName', 'timeWindowLabel',
                         'parcelCode', 'itemCount', 'estimatedWeightKg', 'payoutMinor',
                         'batchStopIndex', 'batchTotalStops', 'exceptionReason',
                         'pickupLat', 'pickupLng', 'dropLat', 'dropLng',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidDeliveryTask(incoming()) &&
                       exists(/databases/$(database)/documents/bookings/$(incoming().bookingId)) &&
                       get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.customerId == incoming().customerId &&
                       get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.workerOwnerId == incoming().workerOwnerId;

      allow update: if isSignedIn() &&
                       isValidId(taskId) &&
                       isValidDeliveryTask(incoming()) &&
                       existing().status != 'handed_over' &&
                       existing().status != 'delivered' &&
                       incoming().bookingId == existing().bookingId &&
                       incoming().customerId == existing().customerId &&
                       incoming().workerOwnerId == existing().workerOwnerId &&
                       incoming().createdAt == existing().createdAt && (
                         // Action: Partner claims offered task atomically
                         (existing().status == 'offered' &&
                          incoming().status == 'accepted' &&
                          incoming().partnerId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['partnerId', 'status', 'updatedAt'])) ||
                         // Action: Assigned partner progresses route stop or streams live GPS
                         ('partnerId' in existing() &&
                          existing().partnerId == request.auth.uid &&
                          incoming().partnerId == existing().partnerId &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'exceptionReason',
                            'agentLat', 'agentLng', 'agentBearing', 'locationUpdatedAt',
                            'updatedAt'
                          ])) ||
                         // Action: Worker confirms handover
                         (existing().workerOwnerId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
                       );
    }

    match /support_tickets/{ticketId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(ticketId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'open' &&
                       incoming().keys().hasAll(['userId', 'category', 'subject', 'description', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'bookingId', 'category', 'subject', 'description', 'status', 'createdAt', 'updatedAt']) &&
                       isValidSupportTicket(incoming());

      allow update: if isSignedIn() &&
                       isValidId(ticketId) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       existing().status != 'resolved' &&
                       isValidSupportTicket(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'description', 'updatedAt']);
    }
  }
}
